<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BerriesParadise.Mobile.ViewModels"
             xmlns:models="clr-namespace:BerriesParadise.Core.Models;assembly=BerriesParadise.Core"
             x:Class="BerriesParadise.Mobile.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             BackgroundColor="{StaticResource Primary}"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="24" Padding="20,16,20,40">

            <!-- Top Brand Header Bar -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" Margin="0,10,0,6">
                <Image Source="logo.png"
                       HeightRequest="36"
                       Aspect="AspectFit"
                       HorizontalOptions="Start" />

                <!-- Language Selector Chips -->
                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                    <Button Text="ES"
                            Padding="8,4"
                            FontSize="11"
                            FontAttributes="Bold"
                            BackgroundColor="{Binding CurrentLanguage, Converter={StaticResource CategoryColorConverter}, ConverterParameter='ES'}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            HeightRequest="28"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="ES" />
                    <Button Text="EN"
                            Padding="8,4"
                            FontSize="11"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource PrimarySurface}"
                            TextColor="{StaticResource TextSecondary}"
                            CornerRadius="12"
                            HeightRequest="28"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="EN" />
                    <Button Text="FR"
                            Padding="8,4"
                            FontSize="11"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource PrimarySurface}"
                            TextColor="{StaticResource TextSecondary}"
                            CornerRadius="12"
                            HeightRequest="28"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="FR" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Cinematic Brand Hero Card -->
            <Border Style="{StaticResource PremiumCard}"
                    Padding="0"
                    BackgroundColor="#0B1A2C">
                <Grid RowDefinitions="220,Auto">
                    <!-- Hero Image Banner -->
                    <Image Grid.Row="0"
                           Source="hero_landscape.jpg"
                           Aspect="AspectFill" />

                    <!-- Dark Gradient Overlay -->
                    <BoxView Grid.Row="0"
                             Color="#9906121E" />

                    <!-- Floating Berry Cluster Accent -->
                    <Image Grid.Row="0"
                           Source="hero_berries.png"
                           Aspect="AspectFit"
                           HeightRequest="150"
                           HorizontalOptions="End"
                           VerticalOptions="End"
                           Margin="0,0,12,-10" />

                    <!-- Hero Text Content -->
                    <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="20,18,20,22">
                        <Label Text="FUTUROS MÁS FRESCOS"
                               Style="{StaticResource BrandEyebrow}" />
                        
                        <Label Text="BERRIES CULTIVADAS CON PROPÓSITO."
                               Style="{StaticResource PageTitle}"
                               FontSize="24"
                               LineHeight="1.15" />
                        
                        <Label Text="{Binding HeroDescription}"
                               Style="{StaticResource SubtitleLabel}"
                               FontSize="13" />

                        <Button Text="Explorar Portafolio Completo"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,8,0,0"
                                Command="{Binding NavigateToProductsCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- The 4 Core Berries Showcase -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="NUESTRAS CUATRO BERRIES"
                           Style="{StaticResource SectionHeading}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Ver todas"
                           TextColor="{StaticResource AccentCyan}"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToProductsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <CollectionView ItemsSource="{Binding Berries}"
                                HeightRequest="210"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Berry">
                            <Border Style="{StaticResource PremiumCard}"
                                    WidthRequest="160"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=NavigateToBerryCommand, x:DataType=viewmodels:HomeViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="120,Auto">
                                    <Image Grid.Row="0"
                                           Source="{Binding ImageUrl, Converter={StaticResource ImagePathConverter}}"
                                           Aspect="AspectFill" />
                                    
                                    <VerticalStackLayout Grid.Row="1" Padding="12,10" Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding Seasonality}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Featured Product Highlight (Big Delight) -->
            <Border Style="{StaticResource PremiumCard}"
                    Padding="16"
                    BackgroundColor="#0B1C33"
                    IsVisible="{Binding FeaturedProduct, Converter={StaticResource CategoryColorConverter}, ConverterParameter='NotNull'}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="DESTACADO DE LA TEMPORADA"
                               Style="{StaticResource BrandEyebrow}" />
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource AccentCyan}"
                                Padding="8,3"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="Big Delight"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="110,*" ColumnSpacing="14">
                        <Image Grid.Column="0"
                               Source="prod_big_delight_clamshell_hd.png"
                               Aspect="AspectFit"
                               HeightRequest="110" />

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding FeaturedProduct.Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding FeaturedProduct.BerryName}"
                                   FontSize="13"
                                   TextColor="{StaticResource AccentCyan}" />
                            <Label Text="{Binding FeaturedProduct.Description}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="3" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Ver Ficha Técnica del Producto"
                            Style="{StaticResource OutlinedButton}"
                            Command="{Binding NavigateToProductDetailCommand}"
                            CommandParameter="{Binding FeaturedProduct}" />
                </VerticalStackLayout>
            </Border>

            <!-- Quick Access Sections Hub -->
            <VerticalStackLayout Spacing="14">
                <Label Text="DESCUBRE BERRIES PARADISE"
                       Style="{StaticResource SectionHeading}" />

                <!-- Genetics Card -->
                <Border Style="{StaticResource PremiumCard}"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToGeneticsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border BackgroundColor="#1E2A4A"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="46"
                                HeightRequest="46"
                                Padding="0">
                            <Image Source="gen_sekoya_pop.jpg" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Genética Patentada"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Amalia®, Eréndira y Sekoya® de alta firmeza"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="→"
                               FontSize="18"
                               TextColor="{StaticResource AccentCyan}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Recipes Card -->
                <Border Style="{StaticResource PremiumCard}"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRecipesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border BackgroundColor="#2D1B36"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="46"
                                HeightRequest="46"
                                Padding="0">
                            <Image Source="recipe_pancakes.jpg" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Recetas &amp; Inspiración"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Ideas culinarias saludables y frescas"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="→"
                               FontSize="18"
                               TextColor="{StaticResource AccentCyan}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Process / Company Card -->
                <Border Style="{StaticResource PremiumCard}"
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAboutCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border BackgroundColor="#0F3330"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="46"
                                HeightRequest="46"
                                Padding="0">
                            <Image Source="proc_campo.jpg" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Del Campo al Mundo"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Cadena de frío y trazabilidad a 19+ países"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="→"
                               FontSize="18"
                               TextColor="{StaticResource AccentCyan}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Global Impact Stats Counter -->
            <Border Style="{StaticResource PremiumCard}"
                    Padding="20"
                    BackgroundColor="#001826"
                    Stroke="#143b52"
                    StrokeThickness="1.2">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ALCANCE INTERNACIONAL"
                               Style="{StaticResource BrandEyebrow}"
                               TextColor="{StaticResource AccentCyan}" />
                        <Label Text="Presencia Global"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Llevamos berries de la más alta calidad a mercados en 4 continentes."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineHeight="1.3" />
                    </VerticalStackLayout>
                    
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <!-- Stat 1: 42+ SKUs -->
                        <Border Grid.Column="0"
                                Padding="10,14"
                                BackgroundColor="#072033"
                                Stroke="#0e3a59"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="42+"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentCyan}"
                                       HorizontalOptions="Center" />
                                <Label Text="SKUs Retail"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center" />
                                <Label Text="Listos anaquel"
                                       FontSize="9"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Stat 2: 19+ Países -->
                        <Border Grid.Column="1"
                                Padding="10,14"
                                BackgroundColor="#072033"
                                Stroke="#0e3a59"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="19+"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#7ee0f9"
                                       HorizontalOptions="Center" />
                                <Label Text="Países"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center" />
                                <Label Text="Exportación"
                                       FontSize="9"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Stat 3: 4 Continentes -->
                        <Border Grid.Column="2"
                                Padding="10,14"
                                BackgroundColor="#072033"
                                Stroke="#0e3a59"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="4"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#f4ef9a"
                                       HorizontalOptions="Center" />
                                <Label Text="Continentes"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center" />
                                <Label Text="Presencia"
                                       FontSize="9"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Contact / Partnership CTA -->
            <Border Style="{StaticResource PremiumCard}"
                    Padding="20"
                    BackgroundColor="#0E243A">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ALIANZAS COMERCIALES"
                           Style="{StaticResource BrandEyebrow}" />
                    <Label Text="Llevamos Berries de Calidad a tu Mercado"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="¿Buscas un socio confiable para tu cadena de suministro internacional? Habla con nuestro equipo comercial."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           LineHeight="1.3" />
                    <Button Text="Contactar Ventas Globales"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ContactSalesCommand}"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
