@* Berries Paradise - Hero Section Component Architecture *@
<div class="bp-hero-bg-media" aria-hidden="true">
    <picture class="bp-hero-picture">
        <source srcset="images/hero/berries-paradise-landscape.webp" type="image/webp" />
        <img src="images/hero/berries-paradise-landscape.png" 
             alt="Berries Paradise panoramic berry fields and sunrise mountains" 
             class="bp-hero-bg-landscape-img" 
             fetchpriority="high"
             decoding="async" />
    </picture>
    <!-- Multi-stop cinematic atmospheric gradient overlay (left 0.72, center 0.15, right 0.35) -->
    <div class="bp-hero-bg-overlay"></div>
</div>
