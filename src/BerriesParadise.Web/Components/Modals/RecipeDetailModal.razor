@inject WebUiStateService State
@implements IDisposable

@if (State.SelectedRecipeModal != null)
{
    var recipe = State.SelectedRecipeModal;
    <div class="bp-modal-backdrop" @onclick="State.CloseRecipeModal" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="bp-modal-box bp-recipe-modal-box" style="max-width: 800px;" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="recipe-modal-title">
            <button type="button" class="bp-modal-close-btn" @onclick="State.CloseRecipeModal" aria-label="Cerrar ventana">✕</button>

            <div class="bp-modal-product-layout">
                <div class="bp-modal-media-box">
                    <img src="@recipe.ImageUrl" alt="@recipe.Title" class="bp-modal-product-img" style="aspect-ratio: 4/3; border-radius: var(--bp-radius-md, 12px); object-fit: cover;" />
                </div>
                
                <div class="bp-modal-info-box">
                    <span style="font-family: var(--bp-font-display, var(--font-display)); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.15em; color: var(--bp-cyan, #08B8E8); text-transform: uppercase;">
                        @recipe.Category
                    </span>
                    <h3 id="recipe-modal-title" style="font-size: 2.2rem; font-weight: 900; color: #ffffff; margin-top: 0.2rem;">
                        @recipe.Title
                    </h3>
                    <p style="color: rgba(255,255,255,0.85); font-size: 0.96rem; margin-top: 0.4rem; line-height: 1.6;">
                        @recipe.Description
                    </p>

                    <div class="bp-modal-recipe-meta" style="display: flex; gap: 1rem; margin-top: 1rem; font-size: 0.85rem; color: var(--bp-cyan, #08B8E8); font-weight: 600; flex-wrap: wrap;">
                        <span>⏱️ Prep: @recipe.PrepTimeMinutes min</span>
                        <span>🔥 Cocción: @recipe.CookTimeMinutes min</span>
                        <span>🍽️ Porciones: @recipe.Servings</span>
                        <span>⚡ @recipe.Calories kcal</span>
                    </div>
                </div>
            </div>

            <!-- Ingredients checklist -->
            <div class="bp-modal-card-note" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--bp-radius-md, 12px); padding: 1.2rem; margin-bottom: 1.4rem;">
                <h4 style="font-size: 0.95rem; color: var(--bp-cyan, #08B8E8); text-transform: uppercase; margin-bottom: 0.8rem;">
                    Ingredientes Frescos
                </h4>

                <div class="bp-modal-ingredients-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
                    @foreach (var ing in recipe.Ingredients)
                    {
                        <label style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.88rem; color: rgba(255,255,255,0.9); cursor: pointer;">
                            <input type="checkbox" style="accent-color: var(--bp-cyan, #08B8E8);" />
                            <span>@ing</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Step-by-step instructions -->
            <div style="margin-bottom: 1.5rem;">
                <h4 style="font-size: 0.95rem; color: #ffffff; text-transform: uppercase; margin-bottom: 0.8rem;">
                    Paso a Paso
                </h4>

                <ol style="padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.7rem; margin: 0;">
                    @foreach (var step in recipe.Instructions)
                    {
                        <li style="font-size: 0.9rem; color: rgba(255,255,255,0.85); line-height: 1.55;">
                            @step
                        </li>
                    }
                </ol>
            </div>

            <div class="bp-modal-footer-row" style="justify-content: flex-end;">
                <button type="button" class="bp-btn bp-btn-cyan" @onclick="State.CloseRecipeModal">
                    ¡Listo para cocinar!
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            State.CloseRecipeModal();
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
