@inject WebUiStateService State
@implements IDisposable

@if (State.IsContactModalOpen)
{
    <div class="bp-modal-backdrop" @onclick="State.CloseContactModal" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="bp-modal-box" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
            <button type="button" class="bp-modal-close-btn" @onclick="State.CloseContactModal" aria-label="Cerrar ventana">✕</button>

            @if (isSubmitted)
            {
                <div style="text-align: center; padding: 2rem 0;">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background: rgba(0, 194, 255, 0.15); border: 2px solid var(--bp-cyan); color: var(--bp-cyan); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto;">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <h3 style="font-size: 1.8rem; margin-bottom: 0.5rem; color: #ffffff;">¡Solicitud Recibida!</h3>
                    <p style="color: rgba(255, 255, 255, 0.8); max-width: 480px; margin: 0 auto 1.5rem auto;">
                        Un director comercial de Berries Paradise se pondrá en contacto contigo en menos de 24 horas con nuestro catálogo de cotizaciones y disponibilidad.
                    </p>
                    <button type="button" class="bp-btn bp-btn-cyan" @onclick="ResetForm">Entendido</button>
                </div>
            }
            else
            {
                <h3 id="contact-modal-title" style="font-family: var(--font-display, 'Barlow Condensed', sans-serif); font-size: 2.2rem; font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.05; margin-bottom: 0.5rem; color: #ffffff;">
                    Contactar a <span style="color: var(--color-cyan, #08B8E8);">Ventas & Distribución</span>
                </h3>
                <p style="color: rgba(247, 250, 252, 0.75); font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.8rem; font-family: var(--font-body, 'Plus Jakarta Sans', sans-serif);">
                    Conéctate directamente con nuestro equipo de exportación para programas retail, mayoreo y abasto internacional.
                </p>

                <form @onsubmit="HandleSubmit" class="bp-contact-form" style="display: flex; flex-direction: column; gap: 1.15rem;">
                    <div class="bp-form-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                        <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                            <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">Nombre Completo *</label>
                            <input type="text" required class="bp-form-input" placeholder="Ej. Roberto Mendoza" @bind="name" style="width: 100%; box-sizing: border-box; background: rgba(0, 24, 38, 0.85); border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; font-family: inherit;" />
                        </div>
                        <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                            <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">Empresa / Retailer *</label>
                            <input type="text" required class="bp-form-input" placeholder="Ej. Whole Foods / Walmart" @bind="company" style="width: 100%; box-sizing: border-box; background: rgba(0, 24, 38, 0.85); border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; font-family: inherit;" />
                        </div>
                    </div>

                    <div class="bp-form-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                        <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                            <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">Correo Corporativo *</label>
                            <input type="email" required class="bp-form-input" placeholder="roberto@empresa.com" @bind="email" style="width: 100%; box-sizing: border-box; background: rgba(0, 24, 38, 0.85); border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; font-family: inherit;" />
                        </div>
                        <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                            <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">País de Destino *</label>
                            <select class="bp-form-select" @bind="country" style="width: 100%; box-sizing: border-box; background-color: #001f30; border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; font-family: inherit; cursor: pointer;">
                                <option value="Estados Unidos">Estados Unidos / USA</option>
                                <option value="Canadá">Canadá</option>
                                <option value="Reino Unido">Reino Unido / UK</option>
                                <option value="Unión Europea">Unión Europea / Países Bajos</option>
                                <option value="Japón">Japón</option>
                                <option value="Emiratos Árabes">Emiratos Árabes Unidos</option>
                                <option value="México">México</option>
                                <option value="Otro">Otro mercado internacional</option>
                            </select>
                        </div>
                    </div>

                    <div class="bp-form-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                        <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                            <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">Producto de Interés</label>
                            <select class="bp-form-select" @bind="berryType" style="width: 100%; box-sizing: border-box; background-color: #001f30; border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; font-family: inherit; cursor: pointer;">
                                <option value="Arándanos (Big Delight / Jumbo)">Arándanos (Big Delight / Jumbo)</option>
                                <option value="Frambuesas (Amalia® / Orgánica)">Frambuesas (Amalia® / Orgánica)</option>
                                <option value="Zarzamoras (Legacy)">Zarzamoras (Legacy)</option>
                                <option value="Fresas Selección">Fresas Selección</option>
                                <option value="Mix Multi-Berry Completo">Mix Multi-Berry Completo</option>
                            </select>
                        </div>

                        <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                            <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">Volumen Estimado</label>
                            <select class="bp-form-select" @bind="volume" style="width: 100%; box-sizing: border-box; background-color: #001f30; border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; font-family: inherit; cursor: pointer;">
                                <option value="1 a 5 Pallets / Semana">1 a 5 Pallets / Semana</option>
                                <option value="1 a 3 Cargas completas (Truckload)">1 a 3 Cargas completas (Truckload)</option>
                                <option value="Programa Anual de Temporada">Programa Anual de Temporada</option>
                                <option value="Carga Aérea Spot">Carga Aérea Spot</option>
                            </select>
                        </div>
                    </div>

                    <div class="bp-form-group" style="display: flex; flex-direction: column; width: 100%;">
                        <label class="bp-form-label" style="display: block; font-family: var(--font-display, sans-serif); font-size: 0.8rem; font-weight: 700; color: #ffffff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.45rem;">Especificaciones del Requerimiento</label>
                        <textarea rows="3" class="bp-form-textarea" placeholder="Especifica calibres, tipo de clamshell o ventana de entrega requerida..." @bind="notes" style="width: 100%; box-sizing: border-box; background: rgba(0, 24, 38, 0.85); border: 1px solid rgba(8, 184, 232, 0.35); border-radius: 8px; padding: 0.75rem 1rem; color: #ffffff; font-size: 0.95rem; outline: none; resize: vertical; min-height: 85px; font-family: inherit;"></textarea>
                    </div>

                    <button type="submit" class="bp-btn bp-btn-yellow" style="width: 100%; margin-top: 0.4rem; justify-content: center; font-size: 0.95rem; padding: 0.9rem 1.5rem; letter-spacing: 0.05em;">
                        <span>Enviar Solicitud a Exportaciones</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 0.4rem;">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </form>
            }
        </div>
    </div>
}

@code {
    private string name = "";
    private string company = "";
    private string email = "";
    private string country = "Estados Unidos";
    private string berryType = "Arándanos (Big Delight / Jumbo)";
    private string volume = "1 a 3 Cargas completas (Truckload)";
    private string notes = "";
    private bool isSubmitted = false;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void HandleSubmit()
    {
        isSubmitted = true;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            State.CloseContactModal();
        }
    }

    private void ResetForm()
    {
        isSubmitted = false;
        name = "";
        company = "";
        email = "";
        notes = "";
        State.CloseContactModal();
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
