@inject ProductCatalog Products
@inject GeneticsCatalog Genetics
@inject RecipeCatalog Recipes
@inject WebUiStateService State
@implements IDisposable

@if (State.IsSearchModalOpen)
{
    <div class="bp-modal-backdrop" @onclick="State.CloseSearchModal" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="bp-modal-box" style="max-width: 640px;" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
            <button type="button" class="bp-modal-close-btn" @onclick="State.CloseSearchModal" aria-label="@State.T("modal.close")">✕</button>

            <h3 id="search-modal-title" style="font-size: 1.6rem; color: #ffffff; margin-bottom: 1rem;">
                @State.T("modal.search.title")
            </h3>

            <div style="position: relative; margin-bottom: 1.5rem;">
                <input type="text" 
                       class="bp-form-input" 
                       placeholder="@State.T("modal.search.placeholder")" 
                       value="@State.SearchQuery" 
                       @oninput="HandleSearchInput"
                       autofocus />
            </div>

            <!-- Search Results -->
            @if (!string.IsNullOrWhiteSpace(State.SearchQuery))
            {
                var query = State.SearchQuery.Trim().ToLowerInvariant();
                var prods = State.GetLocalizedProducts().Where(p => p.Name.ToLowerInvariant().Contains(query) || p.BerryName.ToLowerInvariant().Contains(query) || p.Description.ToLowerInvariant().Contains(query)).ToList();
                var gens = State.GetLocalizedVarieties().Where(g => g.Name.ToLowerInvariant().Contains(query) || g.BerryType.ToLowerInvariant().Contains(query) || g.Description.ToLowerInvariant().Contains(query)).ToList();
                var recs = State.GetLocalizedRecipes().Where(r => r.Title.ToLowerInvariant().Contains(query) || r.Description.ToLowerInvariant().Contains(query)).ToList();

                var hasResults = prods.Any() || gens.Any() || recs.Any();

                if (!hasResults)
                {
                    <div style="text-align: center; padding: 2rem 0; color: rgba(255,255,255,0.6);">
                        @State.T("modal.search.noResults")
                    </div>
                }
                else
                {
                    <div style="max-height: 50vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem;">
                        @if (prods.Any())
                        {
                            <div>
                                <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--bp-cyan); font-weight: 700;">@State.T("modal.search.products")</span>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.4rem;">
                                    @foreach (var p in prods)
                                    {
                                        <div class="bp-product-selector-item" @onclick="() => SelectProduct(p)">
                                            <img src="@p.ClamshellMockupUrl" alt="@p.Name" class="bp-thumb-mini" />
                                            <div>
                                                <div style="font-weight: 700; color: #fff;">@p.Name</div>
                                                <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">@p.BerryName - @p.Badge</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (gens.Any())
                        {
                            <div>
                                <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--bp-cyan); font-weight: 700;">@State.T("modal.search.genetics")</span>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.4rem;">
                                    @foreach (var g in gens)
                                    {
                                        <div class="bp-product-selector-item" @onclick="() => SelectGenetics(g)">
                                            <img src="@g.ImageUrl" alt="@g.Name" class="bp-thumb-mini" />
                                            <div>
                                                <div style="font-weight: 700; color: #fff;">@g.Name</div>
                                                <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">@g.BerryType</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (recs.Any())
                        {
                            <div>
                                <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--bp-cyan); font-weight: 700;">@State.T("modal.search.recipes")</span>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.4rem;">
                                    @foreach (var r in recs)
                                    {
                                        <div class="bp-product-selector-item" @onclick="() => SelectRecipe(r)">
                                            <img src="@r.ImageUrl" alt="@r.Title" class="bp-thumb-mini" />
                                            <div>
                                                <div style="font-weight: 700; color: #fff;">@r.Title</div>
                                                <div style="font-size: 0.8rem; color: rgba(255,255,255,0.6);">@r.Category</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        State.SetSearchQuery(e.Value?.ToString() ?? "");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            State.CloseSearchModal();
        }
    }

    private void SelectProduct(Product p)
    {
        State.SetSelectedProduct(p);
        State.CloseSearchModal();
    }

    private void SelectGenetics(GeneticVariety g)
    {
        State.CloseSearchModal();
        State.OpenGeneticsModal(g);
    }

    private void SelectRecipe(Recipe r)
    {
        State.CloseSearchModal();
        State.OpenRecipeModal(r);
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
