@inject CompanyInformation CompanyInfo
@inject BerryCatalog Berries
@inject WebUiStateService State
@implements IDisposable

<footer class="bp-footer" id="footer-corporativo">
    <div class="bp-footer-container">
        <!-- Top Editorial Row: Large Logo & Language Selector -->
        <div class="bp-footer-top-row">
            <div class="bp-footer-brand-stage">
                <a href="/" class="bp-footer-logo-link" aria-label="Berries Paradise Inicio">
                    <img src="images/berries-paradise-logo.png" alt="@CompanyInfo.CompanyName" class="bp-footer-brand-logo" />
                </a>
                <span class="bp-footer-slogan">Berries Grown with Purpose.</span>
            </div>

            <!-- Language Selector: ES / EN / FR -->
            <div class="bp-footer-language-wrap" role="region" aria-label="Seleccionar idioma">
                <span class="bp-lang-label">@State.T("footer.language")</span>
                <div class="bp-lang-selector">
                    <button type="button" class="bp-lang-btn @(State.CurrentLanguage == "ES" ? "active" : "")" @onclick='() => State.SetLanguage("ES")'>
                        <FlagIcon Code="ES" Width="16" Height="11" />
                        <span>ES</span>
                    </button>
                    <span class="bp-lang-divider">/</span>
                    <button type="button" class="bp-lang-btn @(State.CurrentLanguage == "EN" ? "active" : "")" @onclick='() => State.SetLanguage("EN")'>
                        <FlagIcon Code="EN" Width="16" Height="11" />
                        <span>EN</span>
                    </button>
                    <span class="bp-lang-divider">/</span>
                    <button type="button" class="bp-lang-btn @(State.CurrentLanguage == "FR" ? "active" : "")" @onclick='() => State.SetLanguage("FR")'>
                        <FlagIcon Code="FR" Width="16" Height="11" />
                        <span>FR</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Footer Navigation Columns Grid -->
        <div class="bp-footer-columns-grid">
            <!-- Col 1: PRODUCTOS -->
            <div class="bp-footer-nav-col">
                <h4 class="bp-footer-heading">@State.T("footer.colProducts")</h4>
                <ul class="bp-footer-list">
                    <li><a href="#productos" @onclick='() => OpenCategory("arandanos")'>@State.T("footer.blueberries")</a></li>
                    <li><a href="#productos" @onclick='() => OpenCategory("frambuesas")'>@State.T("footer.raspberries")</a></li>
                    <li><a href="#productos" @onclick='() => OpenCategory("zarzamoras")'>@State.T("footer.blackberries")</a></li>
                    <li><a href="#productos" @onclick='() => OpenCategory("fresas")'>@State.T("footer.strawberries")</a></li>
                </ul>
            </div>

            <!-- Col 2: EMPRESA -->
            <div class="bp-footer-nav-col">
                <h4 class="bp-footer-heading">@State.T("footer.colCompany")</h4>
                <ul class="bp-footer-list">
                    <li><a href="#calidad">@State.T("footer.quality")</a></li>
                    <li><a href="#proceso">@State.T("footer.about")</a></li>
                    <li><a href="#inspiracion">@State.T("footer.inspiration")</a></li>
                    <li><a href="#contacto" @onclick="State.OpenContactModal">@State.T("footer.contact")</a></li>
                </ul>
            </div>

            <!-- Col 3: AYUDA -->
            <div class="bp-footer-nav-col">
                <h4 class="bp-footer-heading">@State.T("footer.colHelp")</h4>
                <ul class="bp-footer-list">
                    <li><a href="#" @onclick="State.OpenContactModal">@State.T("footer.faqs")</a></li>
                    <li><a href="#" @onclick="State.OpenContactModal">@State.T("footer.contact")</a></li>
                </ul>
            </div>

            <!-- Col 4: SOCIALES (Facebook, Instagram, TikTok, LinkedIn, YouTube, X, Pinterest) -->
            <div class="bp-footer-nav-col bp-footer-social-col">
                <h4 class="bp-footer-heading">@State.T("footer.colSocial")</h4>
                <ul class="bp-footer-list bp-social-list">
                    <li>
                        <a href="https://facebook.com/BerriesParadiseOfficial" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">Facebook</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://instagram.com/imberriesparadise/" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">Instagram</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://tiktok.com/@@imberriesparadise" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">TikTok</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://linkedin.com/company/berries-paradise-oficial/" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">LinkedIn</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://youtube.com/@@berriesparadiseofficial" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">YouTube</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://x.com/berriesparadise" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">X</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="https://pinterest.com/berriesparadise" target="_blank" rel="noopener noreferrer">
                            <span class="bp-social-name">Pinterest</span>
                            <span class="bp-social-arrow">↗</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Bottom Legal & Copyright Bar -->
        <div class="bp-footer-bottom-bar">
            <div class="bp-footer-legal-links">
                <a href="#" @onclick:preventDefault="true">@State.T("footer.privacy")</a>
                <span class="bp-legal-dot">•</span>
                <a href="#" @onclick:preventDefault="true">@State.T("footer.terms")</a>
            </div>

            <div class="bp-footer-copyright">
                @State.T("footer.copyright")
            </div>
        </div>
    </div>
</footer>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void OpenCategory(string categoryId)
    {
        var berry = Berries.GetById(categoryId);
        if (berry != null)
        {
            State.OpenBerryModal(berry);
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
