@inject CompanyInformation CompanyInfo
@inject WebUiStateService State
@implements IDisposable

<section class="bp-presence-section" id="presencia-global">
    <div class="bp-presence-container">
        <!-- Left: Intro Editorial Column -->
        <div class="bp-presence-intro">
            <span class="bp-section-kicker fade-up">@State.T("presence.kicker")</span>
            <h2 class="bp-section-headline fade-up delay-1">
                @State.T("presence.title1")<br />
                <span class="highlight-cyan">@State.T("presence.title2")</span>
            </h2>

            <p class="bp-presence-lead fade-up delay-2">
                @State.T("presence.subtitle")
            </p>

            <div class="bp-presence-actions fade-up delay-3">
                <button type="button" class="bp-btn bp-btn-cyan" @onclick="() => State.OpenContactModal()">
                    <span>@State.T("presence.btnExport")</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Center: Premium World Map with animated export routes -->
        <div class="bp-global-map-wrap fade-up delay-2" aria-label="Visualización de presencia internacional">
            <svg class="bp-map-svg" viewBox="0 0 1000 500" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mapa de exportación internacional de Berries Paradise">
                <defs>
                    <linearGradient id="landGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#08b8e8" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="#003b52" stop-opacity="0.20" />
                    </linearGradient>
                    <radialGradient id="hubGlowG" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#f4ef9a" stop-opacity="1" />
                        <stop offset="100%" stop-color="#f4ef9a" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="nodeGlowG" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#08b8e8" stop-opacity="0.9" />
                        <stop offset="100%" stop-color="#08b8e8" stop-opacity="0" />
                    </radialGradient>
                    <pattern id="dotGridG" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
                        <circle cx="2" cy="2" r="1" fill="#08b8e8" fill-opacity="0.15"/>
                    </pattern>
                </defs>

                <!-- Dot grid background -->
                <rect width="1000" height="500" fill="url(#dotGridG)" />

                <!-- Latitude / longitude grid lines -->
                <line x1="0" y1="125" x2="1000" y2="125" stroke="#08b8e8" stroke-width="0.5" stroke-opacity="0.2"/>
                <line x1="0" y1="250" x2="1000" y2="250" stroke="#08b8e8" stroke-width="0.6" stroke-opacity="0.25"/>
                <line x1="0" y1="375" x2="1000" y2="375" stroke="#08b8e8" stroke-width="0.5" stroke-opacity="0.2"/>
                <line x1="200" y1="0" x2="200" y2="500" stroke="#08b8e8" stroke-width="0.4" stroke-opacity="0.15"/>
                <line x1="400" y1="0" x2="400" y2="500" stroke="#08b8e8" stroke-width="0.4" stroke-opacity="0.15"/>
                <line x1="600" y1="0" x2="600" y2="500" stroke="#08b8e8" stroke-width="0.4" stroke-opacity="0.15"/>
                <line x1="800" y1="0" x2="800" y2="500" stroke="#08b8e8" stroke-width="0.4" stroke-opacity="0.15"/>

                <!-- North America - Canada / USA -->
                <path d="M95 40 L180 38 L210 55 L230 70 L240 95 L235 120 L220 140 L200 155 L185 175 L175 195 L165 190 L150 178 L138 163 L125 148 L110 128 L98 105 L88 80 L88 58 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.3" stroke-opacity="0.85"/>
                <!-- Mexico / Central America -->
                <path d="M165 190 L182 195 L198 208 L208 222 L203 238 L192 253 L180 262 L168 255 L160 240 L157 224 L160 207 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.5" stroke-opacity="0.95"/>
                <!-- Greenland -->
                <path d="M212 18 L242 15 L257 30 L250 50 L232 55 L216 45 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="0.8" stroke-opacity="0.6"/>

                <!-- South America -->
                <path d="M205 268 L228 262 L250 268 L268 285 L280 312 L284 342 L280 378 L268 408 L248 432 L228 442 L212 430 L203 408 L198 378 L196 348 L198 316 L201 290 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.3" stroke-opacity="0.85"/>

                <!-- Europe -->
                <path d="M448 52 L480 48 L512 56 L528 70 L522 90 L507 100 L488 105 L468 98 L456 80 L450 65 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.1" stroke-opacity="0.85"/>
                <!-- Iberian peninsula -->
                <path d="M438 88 L460 83 L474 96 L470 115 L452 120 L437 110 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1" stroke-opacity="0.8"/>
                <!-- UK/Scandinavia -->
                <path d="M453 35 L470 28 L482 40 L476 55 L460 58 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="0.8" stroke-opacity="0.7"/>

                <!-- Africa -->
                <path d="M448 128 L492 118 L528 128 L550 155 L560 192 L558 232 L548 272 L530 312 L507 348 L480 362 L458 350 L438 320 L424 285 L420 248 L426 208 L437 168 L444 148 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.3" stroke-opacity="0.85"/>

                <!-- Middle East -->
                <path d="M548 112 L580 105 L608 116 L620 138 L614 158 L596 165 L572 158 L554 140 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.1" stroke-opacity="0.8"/>

                <!-- Russia / Central Asia -->
                <path d="M520 36 L622 26 L722 33 L782 48 L802 67 L792 88 L752 95 L702 90 L652 85 L602 88 L556 82 L530 67 L518 50 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.1" stroke-opacity="0.8"/>

                <!-- India / South Asia -->
                <path d="M618 135 L660 126 L688 138 L698 165 L690 196 L670 220 L650 227 L634 212 L624 188 L617 162 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.1" stroke-opacity="0.8"/>

                <!-- East Asia / China -->
                <path d="M702 86 L762 78 L810 88 L832 114 L830 148 L811 168 L782 176 L756 165 L730 148 L715 125 L705 104 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.2" stroke-opacity="0.85"/>
                <!-- Japan -->
                <path d="M848 102 L860 96 L870 107 L864 125 L853 128 L844 116 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="0.8" stroke-opacity="0.75"/>

                <!-- SE Asia -->
                <path d="M758 166 L787 160 L810 173 L822 198 L810 215 L783 218 L763 205 L752 183 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="0.9" stroke-opacity="0.75"/>

                <!-- Australia -->
                <path d="M762 308 L818 293 L860 303 L877 327 L874 365 L852 392 L820 402 L787 394 L764 373 L748 345 L748 318 Z" fill="url(#landGrad)" stroke="#08b8e8" stroke-width="1.2" stroke-opacity="0.85"/>

                <!-- === ANIMATED EXPORT ROUTES FROM MEXICO (~183, 213) === -->
                <!-- Route 1: To USA & Canada -->
                <path d="M183 213 Q 162 168 150 130" stroke="#08b8e8" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="6 5" fill="none">
                    <animate attributeName="stroke-dashoffset" from="110" to="0" dur="2.8s" repeatCount="indefinite"/>
                </path>
                <!-- Route 2: To Europe -->
                <path d="M183 213 Q 312 98 462 100" stroke="#08b8e8" stroke-width="2" stroke-linecap="round" stroke-dasharray="7 5" fill="none">
                    <animate attributeName="stroke-dashoffset" from="250" to="0" dur="4.5s" repeatCount="indefinite"/>
                </path>
                <!-- Route 3: To South America -->
                <path d="M183 213 Q 196 248 222 318" stroke="#08b8e8" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="5 5" fill="none">
                    <animate attributeName="stroke-dashoffset" from="130" to="0" dur="3.2s" repeatCount="indefinite"/>
                </path>
                <!-- Route 4: Transpacific to Asia (Yellow Highlight Arc) -->
                <path d="M183 213 Q 480 48 780 146" stroke="#f4ef9a" stroke-width="2" stroke-linecap="round" stroke-dasharray="7 6" fill="none" stroke-opacity="0.9">
                    <animate attributeName="stroke-dashoffset" from="520" to="0" dur="6s" repeatCount="indefinite"/>
                </path>
                <!-- Route 5: To Middle East / Africa -->
                <path d="M183 213 Q 330 138 576 136" stroke="#08b8e8" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="6 6" fill="none">
                    <animate attributeName="stroke-dashoffset" from="310" to="0" dur="5.5s" repeatCount="indefinite"/>
                </path>

                <!-- === ORIGIN HUB: MÉXICO === -->
                <circle cx="183" cy="213" r="22" fill="url(#hubGlowG)" opacity="0.6">
                    <animate attributeName="r" values="12;24;12" dur="2.4s" repeatCount="indefinite"/>
                    <animate attributeName="opacity" values="0.4;0.8;0.4" dur="2.4s" repeatCount="indefinite"/>
                </circle>
                <circle cx="183" cy="213" r="7" fill="#f4ef9a" stroke="#001b2a" stroke-width="2.5"/>
                <circle cx="183" cy="213" r="3" fill="#001b2a"/>
                <rect x="150" y="226" width="66" height="18" rx="4" fill="rgba(0, 27, 42, 0.85)" stroke="#f4ef9a" stroke-width="1" />
                <text x="183" y="239" font-family="'Outfit', sans-serif" font-size="10" fill="#f4ef9a" font-weight="700" text-anchor="middle" letter-spacing="0.08em">@State.T("map.mexico")</text>

                <!-- === DESTINATION NODES & BADGES === -->
                <!-- USA -->
                <circle cx="148" cy="132" r="14" fill="url(#nodeGlowG)" opacity="0.45">
                    <animate attributeName="r" values="6;16;6" dur="3s" begin="0.3s" repeatCount="indefinite"/>
                </circle>
                <circle cx="148" cy="132" r="5" fill="#08b8e8" stroke="#001b2a" stroke-width="2"/>
                <rect x="110" y="106" width="76" height="17" rx="3" fill="rgba(0, 27, 42, 0.85)" stroke="rgba(8, 184, 232, 0.5)" stroke-width="0.8" />
                <text x="148" y="118" font-family="'Outfit', sans-serif" font-size="9" fill="#ffffff" font-weight="600" text-anchor="middle">@State.T("map.usa_canada")</text>

                <!-- Europe -->
                <circle cx="462" cy="100" r="14" fill="url(#nodeGlowG)" opacity="0.45">
                    <animate attributeName="r" values="6;16;6" dur="3s" begin="0.8s" repeatCount="indefinite"/>
                </circle>
                <circle cx="462" cy="100" r="5" fill="#08b8e8" stroke="#001b2a" stroke-width="2"/>
                <rect x="432" y="76" width="60" height="17" rx="3" fill="rgba(0, 27, 42, 0.85)" stroke="rgba(8, 184, 232, 0.5)" stroke-width="0.8" />
                <text x="462" y="88" font-family="'Outfit', sans-serif" font-size="9" fill="#ffffff" font-weight="600" text-anchor="middle">@State.T("map.europe")</text>

                <!-- South America -->
                <circle cx="226" cy="328" r="12" fill="url(#nodeGlowG)" opacity="0.45">
                    <animate attributeName="r" values="5;14;5" dur="3s" begin="0.6s" repeatCount="indefinite"/>
                </circle>
                <circle cx="226" cy="328" r="4.5" fill="#08b8e8" stroke="#001b2a" stroke-width="2"/>
                <rect x="186" y="342" width="80" height="17" rx="3" fill="rgba(0, 27, 42, 0.85)" stroke="rgba(8, 184, 232, 0.5)" stroke-width="0.8" />
                <text x="226" y="354" font-family="'Outfit', sans-serif" font-size="9" fill="#ffffff" font-weight="600" text-anchor="middle">@State.T("map.south_america")</text>

                <!-- Asia Pacific -->
                <circle cx="780" cy="146" r="14" fill="url(#nodeGlowG)" opacity="0.45">
                    <animate attributeName="r" values="6;16;6" dur="3s" begin="1.2s" repeatCount="indefinite"/>
                </circle>
                <circle cx="780" cy="146" r="5" fill="#f4ef9a" stroke="#001b2a" stroke-width="2"/>
                <rect x="735" y="120" width="90" height="17" rx="3" fill="rgba(0, 27, 42, 0.85)" stroke="rgba(244, 239, 154, 0.6)" stroke-width="0.8" />
                <text x="780" y="132" font-family="'Outfit', sans-serif" font-size="9" fill="#f4ef9a" font-weight="600" text-anchor="middle">@State.T("map.asia_pacific")</text>

                <!-- Middle East -->
                <circle cx="576" cy="136" r="12" fill="url(#nodeGlowG)" opacity="0.45">
                    <animate attributeName="r" values="5;14;5" dur="3s" begin="1.0s" repeatCount="indefinite"/>
                </circle>
                <circle cx="576" cy="136" r="4.5" fill="#08b8e8" stroke="#001b2a" stroke-width="2"/>
                <rect x="536" y="152" width="80" height="17" rx="3" fill="rgba(0, 27, 42, 0.85)" stroke="rgba(8, 184, 232, 0.5)" stroke-width="0.8" />
                <text x="576" y="164" font-family="'Outfit', sans-serif" font-size="9" fill="#ffffff" font-weight="600" text-anchor="middle">@State.T("map.middle_east")</text>
            </svg>
        </div>

        <!-- Right: Verified Company Metrics Cards Column -->
        <div class="bp-stats-column fade-up delay-3">
            <!-- Metric 1: 42+ SKUs para retail -->
            <div class="bp-stat-pill" @onclick='() => State.SetSelectedProductById("big-delight-arandanos")'>
                <div class="bp-stat-pill-top">
                    <span class="bp-stat-pill-num">42+</span>
                    <span class="bp-stat-pill-icon">📦</span>
                </div>
                <span class="bp-stat-pill-label">@State.T("presence.skus")</span>
                <span class="bp-stat-pill-sub">@State.T("presence.skusSub")</span>
            </div>

            <!-- Metric 2: 19+ Países a los que exportamos -->
            <div class="bp-stat-pill" @onclick='() => State.SetActiveProcessStep(5)'>
                <div class="bp-stat-pill-top">
                    <span class="bp-stat-pill-num">19+</span>
                    <span class="bp-stat-pill-icon">🌍</span>
                </div>
                <span class="bp-stat-pill-label">@State.T("presence.countries")</span>
                <span class="bp-stat-pill-sub">@State.T("presence.countriesSub")</span>
            </div>

            <!-- Metric 3: Mercados globales -->
            <div class="bp-stat-pill">
                <div class="bp-stat-pill-top">
                    <span class="bp-stat-pill-num">@State.T("presence.markets")</span>
                    <span class="bp-stat-pill-icon">✨</span>
                </div>
                <span class="bp-stat-pill-label">@State.T("presence.global")</span>
                <span class="bp-stat-pill-sub">@State.T("presence.globalSub")</span>
            </div>
        </div>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    private void HandleStateChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
    }
}
