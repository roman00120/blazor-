@inject CompanyInformation CompanyInfo
@inject WebUiStateService State
@implements IDisposable

<section class="bp-presence-section" id="presencia-global">
    <!-- Atmospheric Agricultural Landscape Background & Sunlit Horizon -->
    <div class="bp-presence-bg-landscape" aria-hidden="true"></div>
    <div class="bp-presence-bg-gradient" aria-hidden="true"></div>

    <!-- Fresh Harvest Berry Cluster in Bottom Left Foreground -->
    <img src="images/hero-berry-cluster-transparent.png" 
         class="bp-presence-corner-berries fade-up" 
         alt="Berries Paradise Fresh Crop" 
         loading="lazy" 
         aria-hidden="true" />

    <div class="bp-presence-container">
        <!-- 1. LEFT ZONE: Editorial Brand Heading & Export CTA -->
        <div class="bp-presence-intro">
            <div class="bp-presence-kicker-wrap fade-up">
                <span class="bp-presence-kicker">@State.T("presence.kicker")</span>
                <span class="bp-presence-kicker-line" aria-hidden="true"></span>
            </div>

            <h2 class="bp-presence-title fade-up delay-1">
                @State.T("presence.title1")<br />
                <span class="bp-presence-title-cyan">@State.T("presence.title2")</span>
            </h2>

            <p class="bp-presence-quote fade-up delay-2">
                @State.T("presence.subtitle")
            </p>

            <div class="bp-presence-actions fade-up delay-3">
                <button type="button" class="bp-btn bp-btn-cyan bp-presence-cta-btn" @onclick="() => State.OpenContactModal()">
                    <span>@State.T("presence.btnExport")</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <!-- 2. CENTER ZONE: Command World Map Terminal (Midnight Navy with Radiant Cyan Routes) -->
        <div class="bp-global-map-wrap fade-up delay-1" aria-label="Mapa interactivo de presencia internacional">
            <!-- Top Right Floating Navigation & Zoom Controls -->
            <div class="bp-map-controls-panel" aria-label="Controles de navegación del mapa">
                <button type="button" class="bp-map-ctrl-btn" title="Restablecer vista" @onclick="ResetMap" aria-label="Restablecer vista">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                </button>
                <button type="button" class="bp-map-ctrl-btn" title="Acercar mapa" @onclick="ZoomIn" aria-label="Acercar mapa">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <button type="button" class="bp-map-ctrl-btn" title="Alejar mapa" @onclick="ZoomOut" aria-label="Alejar mapa">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <button type="button" class="bp-map-ctrl-btn" title="Centrar en Jalisco, México" @onclick="CenterMexico" aria-label="Centrar en Jalisco, México">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M3 12h3m12 0h3M12 3v3m0 12v3"></path>
                    </svg>
                </button>
            </div>

            <!-- Bottom Left Telemetry Status Badge -->
            <div class="bp-map-telemetry-badge">
                <span class="bp-map-telemetry-title">@State.T("presence.liveRoutes")</span>
                <div class="bp-map-telemetry-hub">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00B4E6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>@State.T("presence.originHub")</span>
                </div>
            </div>

            <!-- World Map SVG Canvas -->
            <svg class="bp-map-svg" viewBox="0 0 1000 520" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mapa de distribución de exportaciones internacionales de Berries Paradise">
                <defs>
                    <linearGradient id="mapLandGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#002b40" stop-opacity="0.9" />
                        <stop offset="100%" stop-color="#001a28" stop-opacity="0.9" />
                    </linearGradient>
                    <radialGradient id="mexicoGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#28c76f" stop-opacity="1" />
                        <stop offset="60%" stop-color="#00b4e6" stop-opacity="0.6" />
                        <stop offset="100%" stop-color="#00b4e6" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="destinationPulse" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                        <stop offset="40%" stop-color="#00e5ff" stop-opacity="0.8" />
                        <stop offset="100%" stop-color="#00b4e6" stop-opacity="0" />
                    </radialGradient>
                    <filter id="cometGlow" x="-30%" y="-30%" width="160%" height="160%">
                        <feGaussianBlur stdDeviation="2.5" result="blur" />
                        <feMerge>
                            <feMergeNode in="blur" />
                            <feMergeNode in="SourceGraphic" />
                        </feMerge>
                    </filter>
                    <pattern id="matrixGrid" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
                        <circle cx="2" cy="2" r="0.8" fill="#00b4e6" fill-opacity="0.12"/>
                    </pattern>
                </defs>

                <!-- Background Subtle Matrix Grid -->
                <rect width="1000" height="520" fill="url(#matrixGrid)" />

                <!-- Stylized Latitude / Longitude Coordinate Lines -->
                <line x1="0" y1="130" x2="1000" y2="130" stroke="#00b4e6" stroke-width="0.5" stroke-opacity="0.16"/>
                <line x1="0" y1="260" x2="1000" y2="260" stroke="#00b4e6" stroke-width="0.6" stroke-opacity="0.2"/>
                <line x1="0" y1="390" x2="1000" y2="390" stroke="#00b4e6" stroke-width="0.5" stroke-opacity="0.16"/>
                <line x1="250" y1="0" x2="250" y2="520" stroke="#00b4e6" stroke-width="0.4" stroke-opacity="0.14"/>
                <line x1="500" y1="0" x2="500" y2="520" stroke="#00b4e6" stroke-width="0.4" stroke-opacity="0.14"/>
                <line x1="750" y1="0" x2="750" y2="520" stroke="#00b4e6" stroke-width="0.4" stroke-opacity="0.14"/>

                <!-- Controllable Map Group (Zoomable) -->
                <g style="@transformStyle">
                    <!-- CONTINENTS -->
                    <!-- North America -->
                    <path d="M120 45 L175 42 L230 58 L275 75 L310 105 L305 130 L290 155 L260 175 L235 200 L210 215 L190 200 L170 185 L155 165 L140 145 L125 115 L115 85 L115 60 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.3" stroke-opacity="0.85"/>
                    <!-- Greenland -->
                    <path d="M295 20 L335 18 L355 35 L345 55 L320 60 L300 48 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="0.8" stroke-opacity="0.6"/>
                    <!-- Central America / Mexico Base -->
                    <path d="M210 215 L232 222 L250 238 L258 255 L250 270 L238 285 L225 292 L212 284 L204 266 L202 248 L206 230 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.4" stroke-opacity="0.9"/>

                    <!-- South America -->
                    <path d="M255 295 L285 288 L312 296 L332 315 L346 345 L350 380 L342 418 L328 450 L304 476 L280 486 L262 472 L250 448 L244 415 L242 380 L246 345 L250 318 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.3" stroke-opacity="0.85"/>

                    <!-- Europe & UK -->
                    <path d="M495 65 L530 60 L568 70 L585 86 L578 108 L560 120 L540 125 L516 116 L502 96 L496 78 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.2" stroke-opacity="0.85"/>
                    <path d="M485 102 L510 96 L526 112 L520 132 L500 138 L484 126 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1" stroke-opacity="0.8"/>
                    <path d="M500 44 L520 36 L534 50 L526 66 L508 70 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="0.9" stroke-opacity="0.75"/>

                    <!-- Africa -->
                    <path d="M498 148 L546 138 L586 148 L610 178 L622 220 L620 262 L608 306 L588 350 L562 388 L532 404 L508 390 L486 356 L470 318 L466 276 L472 232 L484 190 L492 168 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.3" stroke-opacity="0.85"/>

                    <!-- Middle East -->
                    <path d="M608 132 L642 124 L674 136 L688 160 L680 182 L660 190 L634 182 L614 162 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.1" stroke-opacity="0.8"/>

                    <!-- Northern Asia / Russia -->
                    <path d="M578 46 L690 34 L800 42 L866 60 L888 82 L876 104 L832 112 L776 106 L720 100 L665 104 L615 96 L588 80 L576 60 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.2" stroke-opacity="0.85"/>

                    <!-- South Asia / India -->
                    <path d="M684 156 L730 146 L762 160 L772 190 L762 224 L740 250 L718 258 L700 242 L690 214 L682 186 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.1" stroke-opacity="0.8"/>

                    <!-- East Asia / China / Japan -->
                    <path d="M776 102 L842 94 L894 105 L918 134 L916 172 L894 194 L862 202 L834 190 L806 170 L790 144 L780 122 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.2" stroke-opacity="0.85"/>
                    <path d="M934 118 L948 112 L960 124 L952 144 L940 148 L930 134 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="0.9" stroke-opacity="0.8"/>

                    <!-- Southeast Asia -->
                    <path d="M838 190 L870 184 L896 198 L908 226 L896 244 L866 248 L844 234 L832 208 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="0.9" stroke-opacity="0.75"/>

                    <!-- Australia -->
                    <path d="M842 338 L904 322 L950 332 L968 358 L966 400 L942 430 L906 442 L870 432 L844 410 L826 378 L826 348 Z" fill="url(#mapLandGradient)" stroke="#00b4e6" stroke-width="1.2" stroke-opacity="0.85"/>

                    <!-- === RADIANT EXPORT ARCS FROM MEXICO (~226, 240) === -->
                    <!-- 1. Arc to USA West (California / Pacific NW) -->
                    <path d="M226 240 Q 190 190 175 145" stroke="#00b4e6" stroke-width="1.8" stroke-dasharray="5 4" fill="none" stroke-opacity="0.85">
                        <animate attributeName="stroke-dashoffset" from="60" to="0" dur="2.4s" repeatCount="indefinite"/>
                    </path>
                    <!-- 2. Arc to USA East & Canada (New York / Montreal) -->
                    <path d="M226 240 Q 240 170 270 125" stroke="#00b4e6" stroke-width="2" stroke-dasharray="6 4" fill="none" stroke-opacity="0.9">
                        <animate attributeName="stroke-dashoffset" from="80" to="0" dur="2.8s" repeatCount="indefinite"/>
                    </path>
                    <!-- 3. Radiant Arc to Europe (Rotterdam, UK, Germany) -->
                    <path d="M226 240 Q 360 110 528 108" stroke="#00b4e6" stroke-width="2.2" stroke-dasharray="7 5" fill="none">
                        <animate attributeName="stroke-dashoffset" from="220" to="0" dur="4.2s" repeatCount="indefinite"/>
                    </path>
                    <!-- 4. Radiant Arc to South Europe / Mediterranean -->
                    <path d="M226 240 Q 350 140 505 128" stroke="#00b4e6" stroke-width="1.8" stroke-dasharray="6 4" fill="none" stroke-opacity="0.85">
                        <animate attributeName="stroke-dashoffset" from="180" to="0" dur="3.8s" repeatCount="indefinite"/>
                    </path>
                    <!-- 5. Arc to South America (Colombia, Brazil, Chile) -->
                    <path d="M226 240 Q 248 300 295 385" stroke="#00b4e6" stroke-width="2" stroke-dasharray="6 4" fill="none">
                        <animate attributeName="stroke-dashoffset" from="120" to="0" dur="3.2s" repeatCount="indefinite"/>
                    </path>
                    <!-- 6. Radiant Arc to Middle East (UAE / Dubai) -->
                    <path d="M226 240 Q 420 135 640 160" stroke="#00b4e6" stroke-width="1.8" stroke-dasharray="7 5" fill="none">
                        <animate attributeName="stroke-dashoffset" from="280" to="0" dur="5s" repeatCount="indefinite"/>
                    </path>
                    <!-- 7. Radiant Arc to East Asia (Tokyo, Japan & China) -->
                    <path d="M226 240 Q 520 50 860 150" stroke="#00b4e6" stroke-width="2" stroke-dasharray="8 6" fill="none" stroke-opacity="0.9">
                        <animate attributeName="stroke-dashoffset" from="460" to="0" dur="6s" repeatCount="indefinite"/>
                    </path>
                    <!-- 8. Transoceanic Arc to Australia (Sydney) -->
                    <path d="M226 240 Q 540 260 885 380" stroke="#00b4e6" stroke-width="1.6" stroke-dasharray="7 5" fill="none" stroke-opacity="0.8">
                        <animate attributeName="stroke-dashoffset" from="420" to="0" dur="6.5s" repeatCount="indefinite"/>
                    </path>

                    <!-- === LUMINOUS COMETS TRAVELING CONTINUOUSLY ALONG ARCS === -->
                    <circle r="3" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 190 190 175 145" dur="2.4s" repeatCount="indefinite" />
                    </circle>
                    <circle r="3" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 240 170 270 125" dur="2.8s" repeatCount="indefinite" />
                    </circle>
                    <circle r="3.5" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 360 110 528 108" dur="4.2s" repeatCount="indefinite" />
                    </circle>
                    <circle r="3" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 248 300 295 385" dur="3.2s" repeatCount="indefinite" />
                    </circle>
                    <circle r="3" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 420 135 640 160" dur="5s" repeatCount="indefinite" />
                    </circle>
                    <circle r="3.5" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 520 50 860 150" dur="6s" repeatCount="indefinite" />
                    </circle>
                    <circle r="3" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M226 240 Q 540 260 885 380" dur="6.5s" repeatCount="indefinite" />
                    </circle>

                    <!-- === DESTINATION NODES WITH HALO GLOWS === -->
                    <!-- USA West Node -->
                    <circle cx="175" cy="145" r="10" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="175" cy="145" r="4" fill="#ffffff" stroke="#00b4e6" stroke-width="1.8"/>

                    <!-- USA East Node -->
                    <circle cx="270" cy="125" r="11" fill="url(#destinationPulse)" opacity="0.65"/>
                    <circle cx="270" cy="125" r="4.5" fill="#ffffff" stroke="#00b4e6" stroke-width="1.8"/>

                    <!-- Europe Hub Cluster (UK, Rotterdam, Spain) -->
                    <circle cx="528" cy="108" r="14" fill="url(#destinationPulse)" opacity="0.7"/>
                    <circle cx="528" cy="108" r="5" fill="#ffffff" stroke="#00b4e6" stroke-width="2"/>
                    <circle cx="505" cy="128" r="3.5" fill="#00e5ff" stroke="#001826" stroke-width="1"/>
                    <circle cx="548" cy="98" r="3.5" fill="#00e5ff" stroke="#001826" stroke-width="1"/>

                    <!-- South America Node -->
                    <circle cx="295" cy="385" r="11" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="295" cy="385" r="4" fill="#ffffff" stroke="#00b4e6" stroke-width="1.8"/>

                    <!-- Middle East Node -->
                    <circle cx="640" cy="160" r="11" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="640" cy="160" r="4" fill="#ffffff" stroke="#00b4e6" stroke-width="1.8"/>

                    <!-- Asia Node (Japan / China) -->
                    <circle cx="860" cy="150" r="13" fill="url(#destinationPulse)" opacity="0.65"/>
                    <circle cx="860" cy="150" r="4.5" fill="#ffffff" stroke="#00b4e6" stroke-width="2"/>
                    <circle cx="940" cy="130" r="3.5" fill="#00e5ff" stroke="#001826" stroke-width="1"/>

                    <!-- Australia Node -->
                    <circle cx="885" cy="380" r="11" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="885" cy="380" r="4" fill="#ffffff" stroke="#00b4e6" stroke-width="1.8"/>

                    <!-- === ORIGIN HUB: MÉXICO === -->
                    <!-- Mexico territory highlighted in vibrant green/cyan -->
                    <path d="M208 220 L230 228 L244 242 L250 256 L242 268 L232 278 L220 282 L210 274 L204 256 L202 240 Z" fill="#28c76f" fill-opacity="0.85" stroke="#00e5ff" stroke-width="1.5"/>

                    <!-- Pulsating Sonar Waves -->
                    <circle cx="226" cy="240" r="28" fill="url(#mexicoGlow)" opacity="0.6">
                        <animate attributeName="r" values="14;30;14" dur="2.4s" repeatCount="indefinite"/>
                        <animate attributeName="opacity" values="0.3;0.8;0.3" dur="2.4s" repeatCount="indefinite"/>
                    </circle>
                    <circle cx="226" cy="240" r="7.5" fill="#00e5ff" stroke="#001826" stroke-width="2.5"/>
                    <circle cx="226" cy="240" r="3" fill="#ffffff"/>

                    <!-- Origin Tag Pointer: "México" -->
                    <rect x="194" y="210" width="64" height="20" rx="5" fill="rgba(0, 19, 32, 0.95)" stroke="#00b4e6" stroke-width="1" />
                    <text x="226" y="224" font-family="'Outfit', sans-serif" font-size="10.5" fill="#ffffff" font-weight="700" text-anchor="middle" letter-spacing="0.04em">México</text>
                </g>
            </svg>
        </div>

        <!-- 3. RIGHT ZONE: 3 Clean Corporate Stat Cards with Soft Shadows & Watermarks -->
        <div class="bp-stats-column fade-up delay-2">
            <!-- Card 1: 42+ SKUS PARA RETAIL -->
            <div class="bp-stat-card" style="position: relative; overflow: hidden;" role="button" tabindex="0" @onclick='() => State.SetSelectedProductById("big-delight-arandanos")'>
                <!-- Faint 3D Packaging Watermark in background -->
                <svg class="bp-stat-watermark" style="position: absolute; right: -10px; bottom: -15px; width: 90px; height: 90px; max-width: 90px; max-height: 90px; pointer-events: none; opacity: 0.06; color: #003B52;" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="90" height="90">
                    <path d="M50 15 L85 35 L85 75 L50 95 L15 75 L15 35 Z" />
                    <line x1="50" y1="15" x2="50" y2="55" />
                    <line x1="85" y1="35" x2="50" y2="55" />
                    <line x1="15" y1="35" x2="50" y2="55" />
                    <line x1="50" y1="55" x2="50" y2="95" />
                </svg>

                <div class="bp-stat-card-left">
                    <div class="bp-stat-icon-circle">
                        <!-- Isometric Cube Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00A3E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                </div>

                <div class="bp-stat-card-center">
                    <span class="bp-stat-card-num">42+</span>
                    <span class="bp-stat-card-label">@State.T("presence.skus")</span>
                    <span class="bp-stat-card-sub">@State.T("presence.skusSub")</span>
                </div>

                <div class="bp-stat-card-right" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>

            <!-- Card 2: 19+ PAÍSES A LOS QUE EXPORTAMOS -->
            <div class="bp-stat-card" style="position: relative; overflow: hidden;" role="button" tabindex="0" @onclick='() => State.SetActiveProcessStep(5)'>
                <!-- Faint Globe Watermark in background -->
                <svg class="bp-stat-watermark" style="position: absolute; right: -10px; bottom: -15px; width: 90px; height: 90px; max-width: 90px; max-height: 90px; pointer-events: none; opacity: 0.06; color: #003B52;" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="90" height="90">
                    <circle cx="50" cy="50" r="40" />
                    <line x1="10" y1="50" x2="90" y2="50" />
                    <ellipse cx="50" cy="50" rx="20" ry="40" />
                </svg>

                <div class="bp-stat-card-left">
                    <div class="bp-stat-icon-circle">
                        <!-- Globe Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00A3E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                </div>

                <div class="bp-stat-card-center">
                    <span class="bp-stat-card-num">19+</span>
                    <span class="bp-stat-card-label">@State.T("presence.countries")</span>
                    <span class="bp-stat-card-sub">@State.T("presence.countriesSub")</span>
                </div>

                <div class="bp-stat-card-right" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>

            <!-- Card 3: 4 CONTINENTES -->
            <div class="bp-stat-card" style="position: relative; overflow: hidden;" role="button" tabindex="0" @onclick="() => State.OpenContactModal()">
                <!-- Faint Continents / Network Watermark in background -->
                <svg class="bp-stat-watermark" style="position: absolute; right: -10px; bottom: -15px; width: 90px; height: 90px; max-width: 90px; max-height: 90px; pointer-events: none; opacity: 0.06; color: #003B52;" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="90" height="90">
                    <circle cx="25" cy="35" r="14" />
                    <circle cx="75" cy="25" r="18" />
                    <circle cx="35" cy="75" r="16" />
                    <circle cx="70" cy="75" r="14" />
                    <line x1="25" y1="35" x2="75" y2="25" />
                    <line x1="25" y1="35" x2="35" y2="75" />
                    <line x1="75" y1="25" x2="70" y2="75" />
                </svg>

                <div class="bp-stat-card-left">
                    <div class="bp-stat-icon-circle">
                        <!-- Network Nodes Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00A3E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </div>
                </div>

                <div class="bp-stat-card-center">
                    <span class="bp-stat-card-num">@State.T("presence.markets")</span>
                    <span class="bp-stat-card-label">@State.T("presence.global")</span>
                    <span class="bp-stat-card-sub">@State.T("presence.globalSub")</span>
                </div>

                <div class="bp-stat-card-right" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private double zoomLevel = 1.0;
    private string transformStyle => $"transform: scale({zoomLevel.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}); transform-origin: 226px 240px; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);";

    private void ZoomIn()
    {
        if (zoomLevel < 1.6) zoomLevel += 0.2;
    }

    private void ZoomOut()
    {
        if (zoomLevel > 0.8) zoomLevel -= 0.2;
    }

    private void ResetMap()
    {
        zoomLevel = 1.0;
    }

    private void CenterMexico()
    {
        zoomLevel = 1.35;
    }

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    private void HandleStateChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
    }
}
