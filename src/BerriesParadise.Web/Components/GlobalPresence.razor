@inject CompanyInformation CompanyInfo
@inject WebUiStateService State
@implements IDisposable

<section class="bp-presence-section" id="presencia-global">
    <!-- Atmospheric Agricultural Landscape Background & Sunlit Horizon -->
    <div class="bp-presence-bg-landscape" aria-hidden="true"></div>
    <div class="bp-presence-bg-gradient" aria-hidden="true"></div>

    <!-- Fresh Harvest Berry Cluster in Bottom Left Foreground -->
    <img src="images/hero-berry-cluster-transparent.png" 
         class="bp-presence-corner-berries fade-up" 
         alt="Berries Paradise Fresh Crop" 
         loading="lazy" 
         aria-hidden="true" />

    <div class="bp-presence-container">
        <!-- 1. LEFT ZONE: Editorial Brand Heading & Export CTA -->
        <div class="bp-presence-intro">
            <div class="bp-presence-kicker-wrap fade-up">
                <span class="bp-presence-kicker">@State.T("presence.kicker")</span>
                <span class="bp-presence-kicker-line" aria-hidden="true"></span>
            </div>

            <h2 class="bp-presence-title fade-up delay-1">
                @State.T("presence.title1")<br />
                <span class="bp-presence-title-cyan">@State.T("presence.title2")</span>
            </h2>

            <p class="bp-presence-quote fade-up delay-2">
                @State.T("presence.subtitle")
            </p>

            <div class="bp-presence-actions fade-up delay-3">
                <button type="button" class="bp-btn bp-btn-cyan bp-presence-cta-btn" @onclick="() => State.OpenContactModal()">
                    <span>@State.T("presence.btnExport")</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <!-- 2. CENTER ZONE: Command World Map Terminal (Midnight Navy with Radiant Cyan Routes) -->
        <div class="bp-global-map-wrap fade-up delay-1" aria-label="Mapa interactivo de presencia internacional">
            <!-- Top Right Floating Navigation & Zoom Controls -->
            <div class="bp-map-controls-panel" aria-label="Controles de navegación del mapa">
                <button type="button" class="bp-map-ctrl-btn" title="Restablecer vista" @onclick="ResetMap" aria-label="Restablecer vista">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                </button>
                <button type="button" class="bp-map-ctrl-btn" title="Acercar mapa" @onclick="ZoomIn" aria-label="Acercar mapa">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <button type="button" class="bp-map-ctrl-btn" title="Alejar mapa" @onclick="ZoomOut" aria-label="Alejar mapa">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <button type="button" class="bp-map-ctrl-btn" title="Centrar en Jalisco, México" @onclick="CenterMexico" aria-label="Centrar en Jalisco, México">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M3 12h3m12 0h3M12 3v3m0 12v3"></path>
                    </svg>
                </button>
            </div>

            <!-- Bottom Left Telemetry Status Badge -->
            <div class="bp-map-telemetry-badge">
                <span class="bp-map-telemetry-title">@State.T("presence.liveRoutes")</span>
                <div class="bp-map-telemetry-hub">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00B4E6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>@State.T("presence.originHub")</span>
                </div>
            </div>

            <!-- World Map SVG Canvas -->
            <svg class="bp-map-svg" viewBox="0 0 1916 821" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mapa de distribución de exportaciones internacionales de Berries Paradise">
                <defs>
                    <radialGradient id="mexicoGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#28c76f" stop-opacity="1" />
                        <stop offset="50%" stop-color="#00b4e6" stop-opacity="0.7" />
                        <stop offset="100%" stop-color="#00b4e6" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="destinationPulse" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                        <stop offset="40%" stop-color="#00e5ff" stop-opacity="0.8" />
                        <stop offset="100%" stop-color="#00b4e6" stop-opacity="0" />
                    </radialGradient>
                    <filter id="cometGlow" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="3" result="blur" />
                        <feMerge>
                            <feMergeNode in="blur" />
                            <feMergeNode in="SourceGraphic" />
                        </feMerge>
                    </filter>
                    <pattern id="matrixGrid" x="0" y="0" width="30" height="30" patternUnits="userSpaceOnUse">
                        <circle cx="2" cy="2" r="1" fill="#00b4e6" fill-opacity="0.12"/>
                    </pattern>
                </defs>

                <!-- Background Subtle Matrix Grid -->
                <rect width="1916" height="821" fill="url(#matrixGrid)" />

                <!-- Stylized Latitude / Longitude Coordinate Lines -->
                <line x1="0" y1="205" x2="1916" y2="205" stroke="#00b4e6" stroke-width="0.8" stroke-opacity="0.15"/>
                <line x1="0" y1="410" x2="1916" y2="410" stroke="#00b4e6" stroke-width="1.0" stroke-opacity="0.22"/>
                <line x1="0" y1="615" x2="1916" y2="615" stroke="#00b4e6" stroke-width="0.8" stroke-opacity="0.15"/>
                <line x1="479" y1="0" x2="479" y2="821" stroke="#00b4e6" stroke-width="0.8" stroke-opacity="0.15"/>
                <line x1="958" y1="0" x2="958" y2="821" stroke="#00b4e6" stroke-width="0.8" stroke-opacity="0.15"/>
                <line x1="1437" y1="0" x2="1437" y2="821" stroke="#00b4e6" stroke-width="0.8" stroke-opacity="0.15"/>

                <!-- Controllable Map Group (Zoomable & Interactive) -->
                <g style="@transformStyle">
                    <!-- High-Resolution World Map Provided by User -->
                    <image href="images/world-map-cyan.webp" x="0" y="0" width="1916" height="821" preserveAspectRatio="xMidYMid meet" opacity="0.9" />

                    <!-- === RADIANT EXPORT ARCS FROM JALISCO, MÉXICO (370, 375) === -->
                    <!-- 1. Arc to USA West (Los Angeles / California) (285, 295) -->
                    <path d="M 370 375 Q 320 330 285 295" stroke="#00b4e6" stroke-width="2.5" stroke-dasharray="8 6" fill="none" stroke-opacity="0.88">
                        <animate attributeName="stroke-dashoffset" from="80" to="0" dur="2.4s" repeatCount="indefinite"/>
                    </path>
                    <!-- 2. Arc to USA Midwest (Chicago) (445, 260) -->
                    <path d="M 370 375 Q 395 305 445 260" stroke="#00b4e6" stroke-width="2.5" stroke-dasharray="8 6" fill="none" stroke-opacity="0.88">
                        <animate attributeName="stroke-dashoffset" from="80" to="0" dur="2.6s" repeatCount="indefinite"/>
                    </path>
                    <!-- 3. Arc to USA East (New York / Canada) (515, 265) -->
                    <path d="M 370 375 Q 435 310 515 265" stroke="#00b4e6" stroke-width="2.8" stroke-dasharray="9 6" fill="none" stroke-opacity="0.92">
                        <animate attributeName="stroke-dashoffset" from="100" to="0" dur="2.8s" repeatCount="indefinite"/>
                    </path>
                    <!-- 4. Radiant Arc to UK (London) (930, 210) -->
                    <path d="M 370 375 Q 630 180 930 210" stroke="#00b4e6" stroke-width="3" stroke-dasharray="10 7" fill="none">
                        <animate attributeName="stroke-dashoffset" from="240" to="0" dur="4.2s" repeatCount="indefinite"/>
                    </path>
                    <!-- 5. Radiant Arc to Central Europe (Rotterdam / Alemania) (975, 215) -->
                    <path d="M 370 375 Q 660 190 975 215" stroke="#00b4e6" stroke-width="3.2" stroke-dasharray="10 7" fill="none">
                        <animate attributeName="stroke-dashoffset" from="260" to="0" dur="4.4s" repeatCount="indefinite"/>
                    </path>
                    <!-- 6. Radiant Arc to Middle East (Dubai / EAU) (1225, 360) -->
                    <path d="M 370 375 Q 780 140 1225 360" stroke="#00b4e6" stroke-width="2.6" stroke-dasharray="9 7" fill="none">
                        <animate attributeName="stroke-dashoffset" from="320" to="0" dur="5.2s" repeatCount="indefinite"/>
                    </path>
                    <!-- 7. Radiant Arc to East Asia (Tokyo, Japón) (1625, 300) -->
                    <path d="M 370 375 Q 980 50 1625 300" stroke="#00b4e6" stroke-width="3" stroke-dasharray="11 8" fill="none" stroke-opacity="0.92">
                        <animate attributeName="stroke-dashoffset" from="480" to="0" dur="6.2s" repeatCount="indefinite"/>
                    </path>
                    <!-- 8. Radiant Arc to East Asia (Hong Kong / Singapur) (1490, 380) -->
                    <path d="M 370 375 Q 910 100 1490 380" stroke="#00b4e6" stroke-width="2.6" stroke-dasharray="10 7" fill="none" stroke-opacity="0.88">
                        <animate attributeName="stroke-dashoffset" from="440" to="0" dur="5.8s" repeatCount="indefinite"/>
                    </path>
                    <!-- 9. Arc to South America (Colombia / Chile) (490, 520) -->
                    <path d="M 370 375 Q 420 460 490 520" stroke="#00b4e6" stroke-width="2.4" stroke-dasharray="8 6" fill="none">
                        <animate attributeName="stroke-dashoffset" from="140" to="0" dur="3.4s" repeatCount="indefinite"/>
                    </path>

                    <!-- === LUMINOUS COMETS TRAVELING CONTINUOUSLY ALONG ARCS === -->
                    <circle r="4" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 320 330 285 295" dur="2.4s" repeatCount="indefinite" />
                    </circle>
                    <circle r="4" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 395 305 445 260" dur="2.6s" repeatCount="indefinite" />
                    </circle>
                    <circle r="4.5" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 435 310 515 265" dur="2.8s" repeatCount="indefinite" />
                    </circle>
                    <circle r="4" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 630 180 930 210" dur="4.2s" repeatCount="indefinite" />
                    </circle>
                    <circle r="5" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 660 190 975 215" dur="4.4s" repeatCount="indefinite" />
                    </circle>
                    <circle r="4" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 780 140 1225 360" dur="5.2s" repeatCount="indefinite" />
                    </circle>
                    <circle r="5" fill="#ffffff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 980 50 1625 300" dur="6.2s" repeatCount="indefinite" />
                    </circle>
                    <circle r="4" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 910 100 1490 380" dur="5.8s" repeatCount="indefinite" />
                    </circle>
                    <circle r="4" fill="#00e5ff" filter="url(#cometGlow)">
                        <animateMotion path="M 370 375 Q 420 460 490 520" dur="3.4s" repeatCount="indefinite" />
                    </circle>

                    <!-- === DESTINATION NODES WITH HALO GLOWS === -->
                    <!-- USA West (285, 295) -->
                    <circle cx="285" cy="295" r="16" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="285" cy="295" r="6" fill="#ffffff" stroke="#00b4e6" stroke-width="2.5"/>

                    <!-- USA Midwest (445, 260) -->
                    <circle cx="445" cy="260" r="14" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="445" cy="260" r="5.5" fill="#ffffff" stroke="#00b4e6" stroke-width="2.5"/>

                    <!-- USA East / NY (515, 265) -->
                    <circle cx="515" cy="265" r="18" fill="url(#destinationPulse)" opacity="0.65"/>
                    <circle cx="515" cy="265" r="7" fill="#ffffff" stroke="#00b4e6" stroke-width="3"/>

                    <!-- Europe / Rotterdam & UK (930, 210) & (975, 215) -->
                    <circle cx="930" cy="210" r="15" fill="url(#destinationPulse)" opacity="0.65"/>
                    <circle cx="930" cy="210" r="6" fill="#00e5ff" stroke="#ffffff" stroke-width="2"/>
                    <circle cx="975" cy="215" r="20" fill="url(#destinationPulse)" opacity="0.75"/>
                    <circle cx="975" cy="215" r="7.5" fill="#ffffff" stroke="#00b4e6" stroke-width="3"/>

                    <!-- Middle East / Dubai (1225, 360) -->
                    <circle cx="1225" cy="360" r="16" fill="url(#destinationPulse)" opacity="0.65"/>
                    <circle cx="1225" cy="360" r="6" fill="#ffffff" stroke="#00b4e6" stroke-width="2.5"/>

                    <!-- Japan / Tokyo (1625, 300) -->
                    <circle cx="1625" cy="300" r="19" fill="url(#destinationPulse)" opacity="0.7"/>
                    <circle cx="1625" cy="300" r="7" fill="#ffffff" stroke="#00b4e6" stroke-width="3"/>

                    <!-- Asia-Pacífico / Hong Kong (1490, 380) -->
                    <circle cx="1490" cy="380" r="16" fill="url(#destinationPulse)" opacity="0.65"/>
                    <circle cx="1490" cy="380" r="6" fill="#00e5ff" stroke="#ffffff" stroke-width="2"/>

                    <!-- South America (490, 520) -->
                    <circle cx="490" cy="520" r="14" fill="url(#destinationPulse)" opacity="0.6"/>
                    <circle cx="490" cy="520" r="5" fill="#ffffff" stroke="#00b4e6" stroke-width="2"/>

                    <!-- === ORIGIN HUB: JALISCO, MÉXICO (370, 375) === -->
                    <!-- Pulsating Sonar Waves -->
                    <circle cx="370" cy="375" r="42" fill="url(#mexicoGlow)" opacity="0.6">
                        <animate attributeName="r" values="18;46;18" dur="2.4s" repeatCount="indefinite"/>
                        <animate attributeName="opacity" values="0.25;0.75;0.25" dur="2.4s" repeatCount="indefinite"/>
                    </circle>
                    <circle cx="370" cy="375" r="22" stroke="#28c76f" stroke-width="2" fill="none" opacity="0.8">
                        <animate attributeName="r" values="8;32" dur="2s" repeatCount="indefinite"/>
                        <animate attributeName="opacity" values="0.9;0" dur="2s" repeatCount="indefinite"/>
                    </circle>
                    <circle cx="370" cy="375" r="10" fill="#00e5ff" stroke="#001826" stroke-width="3"/>
                    <circle cx="370" cy="375" r="4" fill="#ffffff"/>

                    <!-- Origin Tag Pointer: "Jalisco, México" -->
                    <g transform="translate(370, 335)">
                        <rect x="-60" y="-18" width="120" height="26" rx="6" fill="rgba(0, 19, 32, 0.95)" stroke="#00b4e6" stroke-width="1.5" />
                        <text x="0" y="0" font-family="'Outfit', sans-serif" font-size="12" fill="#ffffff" font-weight="700" text-anchor="middle" dominant-baseline="middle" letter-spacing="0.04em">Jalisco, México</text>
                    </g>
                </g>
            </svg>
        </div>

        <!-- 3. RIGHT ZONE: 3 Clean Corporate Stat Cards with Soft Shadows & Watermarks -->
        <div class="bp-stats-column fade-up delay-2">
            <!-- Card 1: 42+ SKUS PARA RETAIL -->
            <div class="bp-stat-card" style="position: relative; overflow: hidden;" role="button" tabindex="0" @onclick='() => State.SetSelectedProductById("big-delight-arandanos")'>
                <!-- Faint 3D Packaging Watermark in background -->
                <svg class="bp-stat-watermark" style="position: absolute; right: -10px; bottom: -15px; width: 90px; height: 90px; max-width: 90px; max-height: 90px; pointer-events: none; opacity: 0.06; color: #003B52;" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="90" height="90">
                    <path d="M50 15 L85 35 L85 75 L50 95 L15 75 L15 35 Z" />
                    <line x1="50" y1="15" x2="50" y2="55" />
                    <line x1="85" y1="35" x2="50" y2="55" />
                    <line x1="15" y1="35" x2="50" y2="55" />
                    <line x1="50" y1="55" x2="50" y2="95" />
                </svg>

                <div class="bp-stat-card-left">
                    <div class="bp-stat-icon-circle">
                        <!-- Isometric Cube Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00A3E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                </div>

                <div class="bp-stat-card-center">
                    <span class="bp-stat-card-num">42+</span>
                    <span class="bp-stat-card-label">@State.T("presence.skus")</span>
                    <span class="bp-stat-card-sub">@State.T("presence.skusSub")</span>
                </div>

                <div class="bp-stat-card-right" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>

            <!-- Card 2: 19+ PAÍSES A LOS QUE EXPORTAMOS -->
            <div class="bp-stat-card" style="position: relative; overflow: hidden;" role="button" tabindex="0" @onclick='() => State.SetActiveProcessStep(5)'>
                <!-- Faint Globe Watermark in background -->
                <svg class="bp-stat-watermark" style="position: absolute; right: -10px; bottom: -15px; width: 90px; height: 90px; max-width: 90px; max-height: 90px; pointer-events: none; opacity: 0.06; color: #003B52;" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="90" height="90">
                    <circle cx="50" cy="50" r="40" />
                    <line x1="10" y1="50" x2="90" y2="50" />
                    <ellipse cx="50" cy="50" rx="20" ry="40" />
                </svg>

                <div class="bp-stat-card-left">
                    <div class="bp-stat-icon-circle">
                        <!-- Globe Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00A3E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                </div>

                <div class="bp-stat-card-center">
                    <span class="bp-stat-card-num">19+</span>
                    <span class="bp-stat-card-label">@State.T("presence.countries")</span>
                    <span class="bp-stat-card-sub">@State.T("presence.countriesSub")</span>
                </div>

                <div class="bp-stat-card-right" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>

            <!-- Card 3: 4 CONTINENTES -->
            <div class="bp-stat-card" style="position: relative; overflow: hidden;" role="button" tabindex="0" @onclick="() => State.OpenContactModal()">
                <!-- Faint Continents / Network Watermark in background -->
                <svg class="bp-stat-watermark" style="position: absolute; right: -10px; bottom: -15px; width: 90px; height: 90px; max-width: 90px; max-height: 90px; pointer-events: none; opacity: 0.06; color: #003B52;" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="90" height="90">
                    <circle cx="25" cy="35" r="14" />
                    <circle cx="75" cy="25" r="18" />
                    <circle cx="35" cy="75" r="16" />
                    <circle cx="70" cy="75" r="14" />
                    <line x1="25" y1="35" x2="75" y2="25" />
                    <line x1="25" y1="35" x2="35" y2="75" />
                    <line x1="75" y1="25" x2="70" y2="75" />
                </svg>

                <div class="bp-stat-card-left">
                    <div class="bp-stat-icon-circle">
                        <!-- Network Nodes Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00A3E0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                    </div>
                </div>

                <div class="bp-stat-card-center">
                    <span class="bp-stat-card-num">@State.T("presence.markets")</span>
                    <span class="bp-stat-card-label">@State.T("presence.global")</span>
                    <span class="bp-stat-card-sub">@State.T("presence.globalSub")</span>
                </div>

                <div class="bp-stat-card-right" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private double zoomLevel = 1.0;
    private string transformStyle => $"transform: scale({zoomLevel.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}); transform-origin: 370px 375px; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);";

    private void ZoomIn()
    {
        if (zoomLevel < 1.8) zoomLevel += 0.2;
    }

    private void ZoomOut()
    {
        if (zoomLevel > 0.8) zoomLevel -= 0.2;
    }

    private void ResetMap()
    {
        zoomLevel = 1.0;
    }

    private void CenterMexico()
    {
        zoomLevel = 1.45;
    }

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChange;
    }

    private void HandleStateChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= HandleStateChange;
    }
}
