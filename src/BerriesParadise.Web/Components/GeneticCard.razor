@using BerriesParadise.Core.Models
@inject WebUiStateService State
@implements IDisposable

@{
    var v = State.GetLocalizedVariety(Variety);
}

<div class="bp-genetic-editorial-card" 
     @onclick="HandleClick" 
     role="button"
     tabindex="0"
     aria-label="@($"Ver detalles genéticos de {v.Name} ({v.BerryType})")"
     title="@($"{v.Name} - {v.BerryType}")">
     
    <!-- Large photographic berry background image -->
    <div class="bp-genetic-card-media">
        <img src="@v.ImageUrl" alt="@v.Name" class="bp-genetic-photo-img" loading="lazy" />
        <div class="bp-genetic-gradient-overlay"></div>
    </div>

    <!-- Top Badge -->
    <div class="bp-genetic-top-bar">
        <span class="bp-genetic-type-pill">@v.BerryType</span>
        <span class="bp-genetic-brix-tag">@v.BrixRating</span>
    </div>

    <!-- Bottom Editorial Content -->
    <div class="bp-genetic-bottom-content">
        <span class="bp-genetic-subhead">@State.T("genetics.registered")</span>
        <h3 class="bp-genetic-headline">@v.Name</h3>
        
        <!-- Additional information that fades in on hover -->
        <p class="bp-genetic-desc-reveal">
            @v.Description
        </p>

        <div class="bp-genetic-traits-row">
            @foreach (var trait in v.KeyTraits.Take(2))
            {
                <span class="bp-trait-tag">@trait</span>
            }
        </div>

        <div class="bp-genetic-action-row">
            <span class="bp-genetic-action-label">@State.T("genetics.btnSheet")</span>
            <div class="bp-genetic-arrow-btn" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public GeneticVariety Variety { get; set; } = default!;

    [Parameter]
    public EventCallback<GeneticVariety> OnSelect { get; set; }

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private async Task HandleClick()
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(Variety);
        }
    }
}
